<?xml version="1.0" encoding="utf-8"?>
<AppInstaller
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2021"
  Version="@@VERSION@@"
  Uri="@@APPINSTALLER_URI@@">
  <MainPackage
    Name="@@NAME@@"
    Publisher="@@PUBLISHER@@"
    Version="@@VERSION@@"
    ProcessorArchitecture="@@ARCHITECTURE@@"
    Uri="@@PACKAGE_URI@@" />
  <UpdateSettings>
    <OnLaunch
      HoursBetweenUpdateChecks="0"
      ShowPrompt="false"
      UpdateBlocksActivation="false" />
  </UpdateSettings>
</AppInstaller>
